# ─── API Server Environment Settings ─────────────────────────────────────────

# ─── Deployment & CORS ────────────────────────────────────────────────────────
# Comma-separated list of origins permitted to access this API.
# Leave blank to fallback to localhost and personal staging domains.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://gallery.yourdomain.com,https://upload.yourdomain.com

# ─── Cloudflare R2 Binding URL ────────────────────────────────────────────────
# R2 public CDN base URL (e.g., custom domain mapped in Cloudflare R2 bucket settings)
R2_PUBLIC_URL=https://media.yourdomain.com

# ─── JWT Authentication (Admin Panel) ──────────────────────────────────────────
# Cryptographic secret key used to sign Admin session tokens. Generate a secure random string in production.
JWT_SECRET=dev-secret-change-me-highly-confidential

# ─── AI Pipeline Provider ─────────────────────────────────────────────────────
# Toggle between "gemini" (production REST endpoints) and "mock" (instant test stub, no billing)
AI_PROVIDER=mock

# ─── GCP / Vertex AI Credentials (Required if AI_PROVIDER=gemini) ─────────────
# 1. Option A: API Key authentication (easiest for testing)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Option B: IAM Service Account Authentication (production best practice)
# Provide the entire minified GCP Service Account JSON key string (e.g. {"type": "service_account", ...})
GCP_SERVICE_ACCOUNT=

# Vertex AI Model endpoints and routing
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL_NAME=veo-3.1-lite-generate-001
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
