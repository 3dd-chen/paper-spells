# ─── API Base URL ─────────────────────────────────────────────────────────────
# Local development API endpoint (e.g. npx wrangler dev inside apps/api-server)
VITE_API_BASE_URL=http://localhost:8000

# Production API endpoint (deployed Cloudflare Workers URL)
# VITE_API_BASE_URL=https://paper-spells-api.yourusername.workers.dev

# ─── Media CDN base URL ────────────────────────────────────────────────────────
# Base domain where R2 files are served publicly (must match R2_PUBLIC_URL in api-server env)
VITE_MEDIA_BASE_URL=https://media.yourdomain.com
